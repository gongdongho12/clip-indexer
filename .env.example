# When set, DeepSeek becomes the primary chat and vision provider.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
LLM_PROVIDER_MODE=direct
CLIP_INDEXER_VISION_INPUT_MODE=auto

# Generic/OpenAI-compatible provider. Used as fallback when LLM_PROVIDER_MODE=fallback.
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.1-flash-lite

# Optional transcription provider/model (OpenAI-compatible /audio/transcriptions).
OPENAI_AUDIO_MODEL=whisper-1
