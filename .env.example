# DeepSeek handles text first; capable fallback providers handle media directly.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
LLM_PROVIDER_MODE=fallback
CLIP_INDEXER_VISION_INPUT_MODE=auto

# Generic/OpenAI-compatible provider. Used as fallback when LLM_PROVIDER_MODE=fallback.
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.6-flash

# Optional model for providers that expose OpenAI-compatible /audio/transcriptions.
OPENAI_AUDIO_MODEL=whisper-1
